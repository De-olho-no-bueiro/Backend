// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  password             String
  name                 String?
  cpf                  String?   @unique
  profilePicture       Bytes?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  
  posts                Post[]
  comments             Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId Int?

  @@index([postId])
  @@index([authorId])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?  @db.Text
  // Imagens como BYTEA no PostgreSQL (Buffer no Node)
  medias    Bytes[]  @default([])
  published Boolean  @default(false)
  type      String?  // 'alagamento' | 'bueiro'
  nivel     String?  // 'baixo' | 'medio' | 'grave'
  latitude  Float?
  longitude Float?
  endereco  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId Int?

  // Relato opcionalmente vinculado a um bueiro (ponto) ou a uma área (polígono)
  manhole   Manhole? @relation(fields: [manholeId], references: [id], onDelete: SetNull)
  manholeId Int?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  areaId    Int?

  comments Comment[]

  @@index([authorId])
  @@index([manholeId])
  @@index([areaId])
}

model Area {
  id        Int      @id @default(autoincrement())
  name      String
  nivel     String?
  latitude  Float[]
  longitude Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([name])
}

model Manhole {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([name])
}
