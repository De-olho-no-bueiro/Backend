// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             Int       @id @default(autoincrement())
  email          String    @unique
  password       String // apenas hash (bcrypt/argon2) na aplicação
  name           String?
  cpf            String?   @unique
  profilePicture Bytes?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  posts          Post[]
  comments       Comment[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId Int

  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId Int?

  @@index([postId])
  @@index([authorId])
}

model Post {
  id        Int      @id @default(autoincrement())
  title     String
  content   String?  @db.Text
  // Imagens como BYTEA no PostgreSQL (Buffer no Node)
  medias    Bytes[]  @default([])
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId Int?

  // Relato opcionalmente vinculado a um bueiro (ponto) ou a uma área (polígono)
  manhole   Manhole? @relation(fields: [manholeId], references: [id], onDelete: SetNull)
  manholeId Int?
  area      Area?    @relation(fields: [areaId], references: [id], onDelete: SetNull)
  areaId    Int?

  comments Comment[]

  @@index([authorId])
  @@index([manholeId])
  @@index([areaId])
}

model Area {
  id        Int      @id @default(autoincrement())
  name      String
  // Vértices do polígono; validar mesmo tamanho dos dois arrays na aplicação
  latitude  Float[]
  longitude Float[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  // Nome único global costuma ser frágil (ex.: duas "Praça Central"); use índice para busca
  @@index([name])
}

model Manhole {
  id        Int      @id @default(autoincrement())
  name      String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]

  @@index([name])
}
